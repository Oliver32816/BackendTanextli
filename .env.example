# Copia este archivo como .env (en el servidor: chmod 600 .env). NUNCA subas .env a git.

# --- Red (los procesos solo escuchan en localhost; Tailscale los publica) ---
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
ADMIN_PORT=3010

# --- Base de datos: usuario de la aplicación con privilegios mínimos ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tanextli_db
DB_USER=tanextli_app
DB_PASSWORD=

# --- Superusuario de PostgreSQL (solo docker compose y migraciones) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- URL pública (Tailscale Funnel) ---
PUBLIC_BASE_URL=https://olo.tail0de9ec.ts.net

# --- Seguridad ---
JWT_SECRET=
# Sitios web que pueden llamar a la API desde el navegador (separados por comas)
CORS_ORIGINS=https://olo.tail0de9ec.ts.net,https://olo.tail0de9ec.ts.net:8443,http://localhost:5173,http://localhost:3002
# "Continuar con Google": ID(s) de cliente OAuth (Google Cloud Console → APIs y servicios →
# Credenciales), separados por comas. Vacío = desactivado.
GOOGLE_CLIENT_IDS=

# --- Correos (códigos para verificar el correo y restablecer la contraseña) ---
# Gmail: activa la verificación en dos pasos en la cuenta y crea una "contraseña de aplicación"
# (myaccount.google.com/apppasswords). Pega esas 16 letras en SMTP_PASS. NUNCA la subas a git.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CORREO_REMITENTE=
# Dirección de la app web que aparece en los correos
APP_URL=https://olo.tail0de9ec.ts.net:8443

# Panel admin: entran los dispositivos de la red Tailscale. Opcional: limitarlo a estos correos
# de Tailscale (separados por comas). Vacío = cualquier dispositivo de la tailnet.
ADMIN_TAILNET_USERS=
# URL del panel (Tailscale Serve, solo tailnet). Por defecto PUBLIC_BASE_URL:9443
# ADMIN_PUBLIC_URL=https://olo.tail0de9ec.ts.net:9443
ADMIN_REQUIRE_TAILSCALE_IDENTITY=true

# --- Archivos ---
MULTIMEDIA_PATH=/home/olo/tanextli-project/Multimedia/AudiosTanextli
IMAGENES_PATH=/home/olo/tanextli-project/Multimedia/imagenes
